# Copy to deploy/.env (gitignored) and fill in. Never commit the real values.
# ssh target of the web server: the upload user, whose key may only run rsync (rrsync) in the
# deploy directory (deploy/README.md)
DEPLOY_HOST=deploy@example.com
# the deploy directory on the server (it holds site/, nginx.conf and deployed/), as DEPLOY_HOST
# sees it: "." for the upload user, held to it; a full path for a user that is not
DEPLOY_DIR=.
# public origin of the site, no trailing slash: makes the share-card (Open Graph) URLs absolute
DEPLOY_URL=https://example.com
# page analytics (optional): a tracker script that takes a data-site-id, and this site's id in it
ANALYTICS_SRC=
ANALYTICS_SITE_ID=
# Google Tag Manager (optional): the container id, GTM-XXXXXXX. Google Analytics and any other
# tag are set up inside the container.
GTM_ID=
# donations (optional): payment-page links the Donate button opens, by interface language.
# DONATE_URL is English and the fallback; without it there is no Donate button.
DONATE_URL=
DONATE_URL_PT=
DONATE_URL_ES=
# the donations API (optional): where the viewer finds its GraphQL endpoint. Same origin behind the proxy.
API_URL=/api/graphql
# Dokploy deploy webhooks (each application's Deployments tab, "Webhook URL"): `deploy.sh release`
# redeploys the API through the first; the second restarts the site's nginx when nginx.conf changed
API_DEPLOY_WEBHOOK=
SITE_DEPLOY_WEBHOOK=
# telling a newly built city's donors, after a world is deployed (optional; deploy/README.md):
# ANNOUNCE_HOST is an ssh target whose key's forced command is deploy/announce-command.sh (what
# GitHub Actions uses); otherwise API_SERVICE is the API's container on DEPLOY_HOST (its name, or
# the name of the Swarm service whose task runs it), reached with a shell. Both empty: no mail.
ANNOUNCE_HOST=
API_SERVICE=
