# Copy to deploy/.env (gitignored) and fill in. Never commit the real values.
# ssh target of the web server
DEPLOY_HOST=user@example.com
# directory on the server; the site is served from $DEPLOY_DIR/site
DEPLOY_DIR=/srv/tinyworlds
# public origin of the site, no trailing slash: makes the share-card (Open Graph) URLs absolute
DEPLOY_URL=https://example.com
# page analytics (optional): a tracker script that takes a data-site-id, and this site's id in it
ANALYTICS_SRC=
ANALYTICS_SITE_ID=
# Google Tag Manager (optional): the container id, GTM-XXXXXXX. Google Analytics and any other
# tag are set up inside the container.
GTM_ID=
# donations (optional): payment-page links the Donate button opens, by interface language.
# DONATE_URL is English and the fallback; without it there is no Donate button.
DONATE_URL=
DONATE_URL_PT=
DONATE_URL_ES=
# the donations API (optional): where the viewer finds its GraphQL endpoint. Same origin behind the proxy.
API_URL=/api/graphql
