NODE_ENV=development
PORT=4000
# docker-compose.yml in this folder starts this database on port 5434
DATABASE_URL=postgresql://tinyworlds:tinyworlds@localhost:5434/tinyworlds

# Stripe. The secret key creates Checkout sessions; the webhook secret verifies what Stripe posts
# to /api/stripe/webhook. Placeholders are enough to run locally with scripts/send-webhook.mjs.
STRIPE_SECRET_KEY=sk_test_example
STRIPE_WEBHOOK_SECRET=whsec_example
# Pay-what-you-want prices (minimum US$1), one per interface language: the product name on the
# checkout page is in that language.
STRIPE_PRICE_EN=price_example_en
STRIPE_PRICE_PT=price_example_pt
STRIPE_PRICE_ES=price_example_es

# What a city needs before it is built, in US cents.
CITY_GOAL_CENTS=3000

# Origins the site is served from, comma-separated: the CORS allow-list, and the only places a
# checkout may send the donor back to.
ALLOWED_ORIGINS=http://localhost:3000
# The site's origin for every link and picture in a mail (sign-in, thank-you, a city is built).
# Empty: the first of ALLOWED_ORIGINS.
SITE_URL=

# The admin pages (the donation funnel). Who may sign in, comma-separated; empty = nobody. An
# admin signs in through a link sent to their address; so does a donor, to see their cities.
ADMIN_EMAILS=
# Signs the sessions: at least 32 characters (e.g. `openssl rand -hex 32`). Always required in
# production (donors sign in whether or not there are admins); elsewhere once ADMIN_EMAILS names
# someone.
JWT_SECRET=
# The mail server that sends the mails (sign-in links, thank-yous, a city is built), and
# MAIL_FROM the address they come from. Both always required in production; without them
# (development) the mail is written to the API's log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
