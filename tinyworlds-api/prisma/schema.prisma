generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Where a city stands. PROPOSED and FUNDED follow the donations; BUILDING and BUILT are set by hand.
enum CityStatus {
  PROPOSED
  FUNDED
  BUILDING
  BUILT
}

/// A city people can fund, or one that is already on the map.
model City {
  id               String     @id @default(uuid()) @db.Uuid
  /// The name without accents, case or punctuation: what makes "São Paulo" and "sao paulo" one city.
  slug             String     @unique
  /// As first typed by a donor (or seeded).
  name             String
  status           CityStatus @default(PROPOSED)
  goalCents        Int        @map("goal_cents")
  /// US dollars only, in cents. Kept in step with the donations inside one transaction.
  raisedCents      Int        @default(0) @map("raised_cents")
  donationCount    Int        @default(0) @map("donation_count")
  /// The world's id once it is built: "tinynyc".
  worldId          String?    @map("world_id")
  /// Kept out of the public list (a name that should not be shown).
  hidden           Boolean    @default(false)
  /// When its donors were mailed that it is built (src/benefactors/announce-cli.ts); null until
  /// then. Set once, by the run that sends: a second run sends nothing.
  builtAnnouncedAt DateTime?  @map("built_announced_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  donations        Donation[]

  @@map("cities")
}

/// One paid Stripe Checkout session.
model Donation {
  id                    String   @id @default(uuid()) @db.Uuid
  stripeSessionId       String   @unique @map("stripe_session_id")
  stripePaymentIntentId String?  @map("stripe_payment_intent_id")
  amountCents           Int      @map("amount_cents")
  currency              String
  cityId                String?  @map("city_id") @db.Uuid
  city                  City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  /// What the donor typed, cleaned up.
  cityText              String?  @map("city_text")
  /// The map the donor came from: "tinynyc".
  world                 String?
  locale                String?
  /// The visit the checkout was started from, when the site said: ties the donation to its funnel.
  visitId               String?  @map("visit_id") @db.Uuid
  /// Who gave, when Stripe said (by email); null for a gift with no usable address.
  donorId               String?  @map("donor_id") @db.Uuid
  donor                 Donor?   @relation(fields: [donorId], references: [id], onDelete: SetNull)
  /// The donor asked to be named for this city's gift (a name, and a city).
  listed                Boolean  @default(false)
  createdAt             DateTime @default(now()) @map("created_at")

  @@index([cityId])
  @@index([createdAt])
  @@index([donorId])
  @@map("donations")
}

/// Someone who has given, known by the email Stripe collected. Never exposed in GraphQL.
model Donor {
  id          String      @id @default(uuid()) @db.Uuid
  /// Lower case.
  email       String      @unique
  /// How the donor is named on the lists; null until a gift came with a name.
  displayName String?     @map("display_name")
  nameHidden  Boolean     @default(false) @map("name_hidden")
  /// An admin took the donor's links off every list; the name stays.
  linksHidden Boolean     @default(false) @map("links_hidden")
  /// When the donor was mailed that they are in the hall of fame (src/benefactors/hall-cli.ts);
  /// null until then. Set once, by the run that sends: a second run mails them nothing.
  hallMailedAt DateTime?  @map("hall_mailed_at")
  lastLoginAt DateTime?   @map("last_login_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  donations   Donation[]
  magicLinks  MagicLink[]
  links       DonorLink[]

  @@map("donors")
}

/// A page a donor points to beside their name: up to three (LINKS_MAX). What the page says of
/// itself (title, description, picture, icon) is read once, when the link is saved, and again
/// only when the donor asks.
model DonorLink {
  id          String      @id @default(uuid()) @db.Uuid
  donorId     String      @map("donor_id") @db.Uuid
  donor       Donor       @relation(fields: [donorId], references: [id], onDelete: Cascade)
  /// As cleaned (cleanLinkUrl): https, a public host name, no credentials, port or fragment.
  url         String
  /// The page's own title, cleaned; its host name when it gave none.
  title       String
  description String?
  /// When the page was last read.
  readAt      DateTime    @map("read_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  images      LinkImage[]

  @@unique([donorId, url])
  @@map("donor_links")
}

/// What a link's image is of: the site's icon, or the page's picture (its og:image).
enum LinkImageKind {
  ICON
  PICTURE
}

/// A small copy of a link's icon or picture, drawn again here as WebP: the site shows these, so
/// a visitor's browser never asks the linked page's server for anything. A new reading of the
/// page makes new rows (new ids), so an id's bytes never change.
model LinkImage {
  id        String        @id @default(uuid()) @db.Uuid
  linkId    String        @map("link_id") @db.Uuid
  link      DonorLink     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  kind      LinkImageKind
  bytes     Bytes
  width     Int
  height    Int
  createdAt DateTime      @default(now()) @map("created_at")

  @@unique([linkId, kind])
  @@map("link_images")
}

/// The steps of a visit towards a donation, in order. The last one, a paid donation, is not an
/// event: it is a row of `donations`, written from Stripe's webhook.
enum FunnelStep {
  VISIT
  DONATE_OPENED
  CHECKOUT_STARTED
  CHECKOUT_CANCELLED
}

/// One step one visit reached on one site (a world, or the front page): recorded once.
model FunnelEvent {
  id          String     @id @default(uuid()) @db.Uuid
  /// Made up by the browser for one tab's visit. Not a person: it is gone when the tab closes.
  visitId     String     @map("visit_id") @db.Uuid
  step        FunnelStep
  /// Where it happened: "tinynyc", or "home" for the front page.
  world       String
  locale      String?
  /// The city the step was about (the one a checkout was started for), when the site said.
  city        String?
  amountCents Int?       @map("amount_cents")
  createdAt   DateTime   @default(now()) @map("created_at")
  /// On a VISIT: the last time the page said it was still open (and in view). It starts as the
  /// visit's own time; null on visits from before the site said so (the history from the page
  /// analytics among them). With `created_at`, how long a visit stayed.
  lastSeenAt  DateTime?  @map("last_seen_at")

  @@unique([visitId, step, world])
  @@index([createdAt])
  @@index([step, world])
  @@index([step, lastSeenAt])
  @@map("funnel_events")
}

/// Someone who may see the admin pages. Who that is, is decided by ADMIN_EMAILS: the row is made
/// the first time one of those addresses asks for a sign-in link.
model Admin {
  id          String      @id @default(uuid()) @db.Uuid
  /// Lower case.
  email       String      @unique
  lastLoginAt DateTime?   @map("last_login_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  magicLinks  MagicLink[]

  @@map("admins")
}

/// A sign-in link sent by email: good once, and only for a few minutes. The token itself is
/// never stored, only its SHA-256. It is an admin's or a donor's, never both (a check in the
/// migration, magic_links_one_owner).
model MagicLink {
  id        String    @id @default(uuid()) @db.Uuid
  adminId   String?   @map("admin_id") @db.Uuid
  admin     Admin?    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  donorId   String?   @map("donor_id") @db.Uuid
  donor     Donor?    @relation(fields: [donorId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([donorId, createdAt])
  @@map("magic_links")
}

/// One answer to "Guess the building": which name a visit picked for one building. A visit
/// answers a building once; the API keeps no copy of the questions (the right name is the
/// building itself).
model QuizAnswer {
  id        String   @id @default(uuid()) @db.Uuid
  /// The tab's visit (as the funnel's): not a person, gone when the tab closes.
  visitId   String   @map("visit_id") @db.Uuid
  world     String
  /// The building asked about: a sight id from the world's sights.json.
  sightId   String   @map("sight_id")
  /// The sight id the visitor picked; right when it equals sightId.
  choice    String
  /// The game's difficulty: each offers other wrong answers. Answers from before it existed are HARD.
  level     QuizLevel @default(HARD)
  locale    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([visitId, world, sightId, level])
  @@index([world, sightId, level])
  @@map("quiz_answers")
}

enum QuizLevel {
  EASY
  MEDIUM
  HARD
}
